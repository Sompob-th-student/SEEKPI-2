// SEEKPI-2 on Cloudflare: one Worker serves the React app (Static Assets) and the API (/api/*), data in D1.
// Before the first deploy replace database_id with the id printed by `npx wrangler d1 create seekpi2`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seekpi-2",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // React Router: unknown paths load index.html
    "not_found_handling": "single-page-application",
    // API requests always go to the Worker, never to the asset fallback
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "seekpi2",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
  // Secrets (not stored in this file): JWT_SECRET  ->  npx wrangler secret put JWT_SECRET
}
